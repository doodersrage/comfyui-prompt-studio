# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/e2e/.auth/

# next.js
/.next/
/out/

# production
/build
/site

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local Python engine envs (must never enter NFT / git)
**/.venv/
services/**/.venv/

# prettier cache
.prettiercache

# desktop (Tauri) build artifacts
/desktop/src-tauri/target/
/desktop/src-tauri/resources/server/*
!/desktop/src-tauri/resources/server/.gitkeep
/desktop/src-tauri/binaries/*
!/desktop/src-tauri/binaries/.gitkeep
/desktop/node_modules/
