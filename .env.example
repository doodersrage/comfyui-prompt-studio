# Copy to .env.local and adjust.

# --- LLM (OpenAI-compatible) ---
LLM_ENABLED=true
LLM_API_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=dolphin-llama3
# Vision-capable model for Image → Prompt, Refine critique, and gallery tags.
# Example (Ollama): qwen3-vl:latest  — leave empty to fall back to LLM_MODEL (text-only will fail vision tools).
LLM_VISION_MODEL=qwen3-vl:latest
LLM_TEMPERATURE=0.95
ALLOW_TEMPLATE_FALLBACK=true

# --- Optional API auth ---
# When set, cross-origin and non-browser clients must send:
#   Authorization: Bearer <token>
# Same-origin browser UI continues to work without the header.
# PROMPT_API_TOKEN=

# --- Inference engine (ComfyUI primary for generate) ---
# Default: comfyui. Set to diffusers for optional experimental txt2img.
PROMPT_ENGINE=comfyui
# NEXT_PUBLIC_PROMPT_ENGINE=comfyui
DIFFUSERS_API_URL=http://127.0.0.1:8190
# NEXT_PUBLIC_DIFFUSERS_API_URL=http://127.0.0.1:8190
# When Diffusers is selected and offline on localhost, Studio can spawn the service.
# Settings → Inference engine also has a browser toggle.
DIFFUSERS_AUTOSTART=1
# DIFFUSERS_ENGINE_DIR=/absolute/path/to/services/diffusers-engine

# --- ComfyUI (primary generate + specialty graphs) ---
COMFYUI_API_URL=http://127.0.0.1:8188
# Local ComfyUI install path for Settings → Model assets Install (same machine).
# The Prompt Studio process user must be able to write under $COMFYUI_ROOT/models.
# COMFYUI_ROOT=/opt/comfyui
# Optional Hugging Face token for gated / rate-limited curated downloads.
# HF_TOKEN=
# Optional Civitai token for gated LoRA downloads (Settings → LoRA library search).
# CIVITAI_API_TOKEN=
# When false, ignore client-supplied comfy.apiUrl / ?comfyUrl= (env URL only).
COMFYUI_ALLOW_CLIENT_URL=true
# Optional comma-separated hostname allowlist for ComfyUI URLs.
# Required for probe/queue when set. Settings extras cannot change this — copy the cluster snippet.
# COMFYUI_ALLOWED_HOSTS=127.0.0.1,localhost,comfyui

# Server workflow JSON (optional)
# COMFYUI_WORKFLOW_PATH=
# COMFYUI_WORKFLOW_DIR=
# COMFYUI_WORKFLOW_PATHS=

# --- Webhooks ---
# Allow webhook dispatch to private/LAN URLs (default: blocked).
# WEBHOOK_ALLOW_PRIVATE=false

# --- User accounts (optional) ---
# PROMPT_AUTH_ENABLED=true
# PROMPT_ADMIN_USERNAME=admin
# PROMPT_ADMIN_PASSWORD="change-me"  # quote values containing $ or #
# PROMPT_SESSION_SECRET=use-a-long-random-string
# PROMPT_AUTH_DIR=  # defaults to PROMPT_DATA_DIR/auth

# --- Server storage & sync ---
# Durable gallery/history/settings via /api/storage (SQLite at $PROMPT_DATA_DIR/studio.sqlite)
# PROMPT_DATA_DIR=/var/lib/prompt-studio
# Existing JSON files are imported once and renamed *.json.imported.
# When auth is enabled, authenticated users get per-user scopes in the same database.

# Per-user scheduled campaigns and gallery/history export snapshots (cron or manual):
# POST /api/maintenance/run with SERVER_USER_MAINTENANCE=true
# SERVER_USER_MAINTENANCE=true

# Comma-separated ComfyUI backends merged with Settings extras at queue time.
# After Test on Settings → ComfyUI cluster, copy the snippet (pool + allowlist) here and restart.
# COMFYUI_POOL=http://127.0.0.1:8188,http://127.0.0.1:8189

# Public origin for invite / password-reset links and email footers (not the ComfyUI URL).
# PROMPT_API_URL=http://127.0.0.1:47832

# Inbound webhook secret for POST /api/hooks/generate
# INBOUND_WEBHOOK_SECRET=

# Optional passphrase for encrypted server export snapshots
# EXPORT_PASSPHRASE=

# --- API observability ---
# API_RATE_LIMIT_WINDOW_MS=60000
# API_RATE_LIMIT_MAX=120

# --- Optional adult/NSFW generator plugin (hidden unless both are true) ---
# PROMPT_NSFW_GENERATOR_ENABLED=true
# NEXT_PUBLIC_PROMPT_NSFW_GENERATOR_ENABLED=true

# --- Embedding search (optional; falls back to token matching) ---
# LLM_EMBED_MODEL=nomic-embed-text

# --- Queue artifacts ---
# Write JSON sidecars after successful ComfyUI queue (Settings can overlay if this is unset)
# COMFYUI_QUEUE_EXPORT_DIR=/var/lib/prompt-studio/queue

# --- Email (SMTP) ---
# Env is the fallback. Settings → Users → SMTP overlays the same keys under PROMPT_DATA_DIR.
# PROMPT_EMAIL_ENABLED=true
# PROMPT_SMTP_HOST=smtp.example.com
# PROMPT_SMTP_PORT=587
# PROMPT_SMTP_SECURE=false
# PROMPT_SMTP_USER=
# PROMPT_SMTP_PASS=
# PROMPT_EMAIL_FROM=Prompt Studio <noreply@example.com>
# PROMPT_ADMIN_EMAIL=admin@example.com
# PROMPT_EMAIL_NOTIFY_BATCH=true
# PROMPT_EMAIL_NOTIFY_PASSWORD=true

# --- Server scheduled batch (headless; needs PROMPT_DATA_DIR above) ---
# Browser scheduled batch (Settings → Automation) is separate and needs an open tab.
# SERVER_SCHEDULED_BATCH=true
# SERVER_SCHEDULED_BATCH_INTERVAL_MIN=60
# SERVER_SCHEDULED_BATCH_TARGET=random-scene
# SERVER_SCHEDULED_BATCH_COUNT=3
# SERVER_SCHEDULED_BATCH_QUEUE=false
# SERVER_SCHEDULED_BATCH_GENRE=
